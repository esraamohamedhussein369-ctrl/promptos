# Add your provider key here in a local .env file (never commit that file).
OPENAI_API_KEY=

# OpenAI API or another OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
AI_TIMEOUT_MS=60000

# Account security. Generate both secret values privately and do not commit them.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SIGNUP_INVITE_CODE=
ADMIN_EMAIL=
AI_DAILY_LIMIT=20

# Email verification and password recovery via Resend.
RESEND_API_KEY=
EMAIL_FROM=PromptOS <accounts@your-verified-domain.example>
# APP_URL is optional on Render; RENDER_EXTERNAL_URL is used when it is unset.
APP_URL=

# Optional server settings.
PORT=3000
# HOST=127.0.0.1
# Local development defaults to SQLite. Production requires a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_PATH=.data/promptos.sqlite
# Trust X-Forwarded-For only when the app is reachable exclusively through a trusted proxy.
TRUST_PROXY=false
